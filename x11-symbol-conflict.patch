From f0b76eba072821d62e74ebdbd8da9243a2ce3b84 Mon Sep 17 00:00:00 2001
From: Rong Bao <webmaster@csmantle.top>
Date: Fri, 21 Aug 2026 01:37:17 +0000
Subject: [PATCH] Bug 2065007 - Redefine X11's Success macro to X11Success to
 avoid conflicts.  a=RyanVM

Original Revision: https://phabricator.services.mozilla.com/D319993

Differential Revision: https://phabricator.services.mozilla.com/D320035
---
 gfx/gl/GLContextProviderGLX.cpp | 2 +-
 gfx/src/X11UndefineNone.h       | 5 +++++
 gfx/thebes/gfxPlatformGtk.cpp   | 4 ++--
 widget/gtk/WidgetUtilsGtk.cpp   | 6 +++---
 4 files changed, 11 insertions(+), 6 deletions(-)

diff --git a/gfx/gl/GLContextProviderGLX.cpp b/gfx/gl/GLContextProviderGLX.cpp
index 384fff9eea1c7..cfec89c05afb4 100644
--- a/gfx/gl/GLContextProviderGLX.cpp
+++ b/gfx/gl/GLContextProviderGLX.cpp
@@ -680,7 +680,7 @@ static bool ChooseConfig(GLXLibrary* glx, Display* display, int screen,
 
     int visid;
     if (glx->fGetFBConfigAttrib(display, curConfig, LOCAL_GLX_VISUAL_ID,
-                                &visid) != Success) {
+                                &visid) != X11Success) {
       continue;
     }
 
diff --git a/gfx/src/X11UndefineNone.h b/gfx/src/X11UndefineNone.h
index 8cfbb0bf7410f..7e59f366b442a 100644
--- a/gfx/src/X11UndefineNone.h
+++ b/gfx/src/X11UndefineNone.h
@@ -50,3 +50,8 @@
 #  undef DestroyAll
 #  define X11DestroyAll 0
 #endif
+
+#ifdef Success
+#  undef Success
+#  define X11Success 0
+#endif
diff --git a/gfx/thebes/gfxPlatformGtk.cpp b/gfx/thebes/gfxPlatformGtk.cpp
index 2b0359fe45534..e1a7abea89926 100644
--- a/gfx/thebes/gfxPlatformGtk.cpp
+++ b/gfx/thebes/gfxPlatformGtk.cpp
@@ -494,7 +494,7 @@ static nsTArray<uint8_t> GetDisplayICCProfile(Display* dpy, Window& root) {
 
   if (XGetWindowProperty(dpy, root, iccAtom, 0, INT_MAX /* length */, X11False,
                          AnyPropertyType, &retAtom, &retFormat, &retLength,
-                         &retAfter, &retProperty) != Success) {
+                         &retAfter, &retProperty) != X11Success) {
     return nsTArray<uint8_t>();
   }
 
@@ -563,7 +563,7 @@ nsTArray<uint8_t> gfxPlatformGtk::GetPlatformCMSOutputProfileData() {
 
   if (XGetWindowProperty(dpy, root, edidAtom, 0, 32, X11False, AnyPropertyType,
                          &retAtom, &retFormat, &retLength, &retAfter,
-                         &retProperty) != Success) {
+                         &retProperty) != X11Success) {
     return nsTArray<uint8_t>();
   }
 
diff --git a/widget/gtk/WidgetUtilsGtk.cpp b/widget/gtk/WidgetUtilsGtk.cpp
index f5bab748a8474..c5a6f40797301 100644
--- a/widget/gtk/WidgetUtilsGtk.cpp
+++ b/widget/gtk/WidgetUtilsGtk.cpp
@@ -494,7 +494,7 @@ static nsCString GetWindowManagerName() {
                          req_type, &actual_type_return, &actual_format_return,
                          &nitems_return, &bytes_after_return, &prop_return);
 
-  if (result != Success || bytes_after_return != 0 || nitems_return != 1) {
+  if (result != X11Success || bytes_after_return != 0 || nitems_return != 1) {
     return {};
   }
 
@@ -518,7 +518,7 @@ static nsCString GetWindowManagerName() {
                          false,      // delete
                          req_type, &actual_type_return, &actual_format_return,
                          &nitems_return, &bytes_after_return, &prop_return);
-  if (result != Success || bytes_after_return != 0) {
+  if (result != X11Success || bytes_after_return != 0) {
     return {};
   }
 
@@ -615,7 +615,7 @@ static uint32_t GetWindowUserTime(GdkDisplay* aDisplay, uintptr_t aWindow) {
 
   if (XGetWindowProperty(xDisplay, aWindow, atom, 0, 1, false, XA_CARDINAL,
                          &actualType, &actualFormat, &numberOfItems,
-                         &bytesAfter, &property) == Success &&
+                         &bytesAfter, &property) == X11Success &&
       property) {
     if (numberOfItems == 1) {
       userTime = *((uint32_t*)property);
